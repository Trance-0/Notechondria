# =============================================================================
# Notechondria – Northflank deployment environment
# =============================================================================
# Paste into: Northflank > project > notechondria-backend > Environment
# > Edit as text. Put secret values in a Secret Group and link it to the
# service instead of pasting plaintext secrets here.
#
# Variables sourced automatically from the notechondria-postgres addon when
# you apply northflank.json — the template wires them via ${refs.database.*}.
# Do NOT set them here. If you create the service manually, link the addon
# under Service > Environment > Link addon instead.
#   DATABASE_URL, POSTGRE_HOST, POSTGRE_PORT, POSTGRE_DB,
#   POSTGRE_USERNAME, POSTGRE_PASSWORD
#
# Docker-Compose-only variables from sample.test.env (not migrated here):
#   DJANGO_ALLOWED_HOSTS_COMPOSE, APP_HOST_PORT, BACKEND_HOST_PORT,
#   FRONTEND_HOST_PORT, DB_HOST_PORT, ROOT_HTTP_PORT,
#   FRONTEND_BACKEND_ORIGIN, APP_IMAGE, NGINX_IMAGE, FRONTEND_IMAGE,
#   NOTECHONDRIA_SHARED_NETWORK, DB_AUTO_REINIT_IF_MISMATCH,
#   RENDER_MCP_API_KEY

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------
# Secret key for Django's cryptographic signing (REQUIRED – no default).
DJANGO_SECRET_KEY=REPLACE_ME_WITH_50_CHAR_RANDOM_STRING
# Run Django in debug mode (True/False). Never enable in production.
DJANGO_DEBUG=False
# Northflank publishes services at https://<service>--<project>.<region>.code.run
# by default. Add your own domain via Project > Domains and list it here.
DJANGO_ALLOWED_HOSTS=*
# Comma-separated origins that Django trusts for CSRF verification.
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.code.run
# Logging level for the django logger (DEBUG, INFO, WARNING, ERROR, CRITICAL).
DJANGO_LOG_LEVEL=INFO
# Base name for the daily log file written under backend/logs/.
DJANGO_LOG_FILE_NAME=notechondria
# Initial superuser created by bootstrap_platform management command.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=you@example.com
DJANGO_SUPERUSER_PASSWORD=REPLACE_ME
# Custom domain pointing to the backend (attach via Project > Domains).
BACKEND_CUSTOM_DOMAIN=notechondria.example.com
# Root paths for collected static and media files inside the container.
DJANGO_PRODUCTION_STATIC_ROOT=/home/staticfiles/
DJANGO_PRODUCTION_MEDIA_ROOT=/home/mediafiles/

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Northflank injects PORT; keep 8000 to match the Dockerfile EXPOSE.
PORT=8000
PYTHONUNBUFFERED=1
WEB_CONCURRENCY=2

# -----------------------------------------------------------------------------
# SMTP Email
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=REPLACE_ME
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_FROM_EMAIL=no-reply@notechondria.com
# Hours before a verification code expires.
SMTP_EMAIL_VERIFICATION_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Origin of the frontend app – used for CORS on the backend.
FRONTEND_ORIGIN=https://trance-0.github.io
# Page where the user types or confirms the SMTP verification code.
FRONTEND_VERIFY_URL=https://trance-0.github.io/Notechondria/portal/#/verify
# API base URL baked into the frontend at build time (--dart-define).
FRONTEND_API_BASE_URL=https://notechondria.example.com/api/v1
# Base href for each frontend sub-app.
APP_BASE_HREF=/

# -----------------------------------------------------------------------------
# OpenAI Integration (optional)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# GitHub App Integration (optional)
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_AUTHORIZED_REDIRECT_URI=https://notechondria.example.com/auth/github/callback
# Paste the PEM private key contents. For Northflank put this in a Secret
# Group – the value can span multiple lines inside a Secret Group field.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_URI=https://notechondria.example.com/auth/github/webhook
GITHUB_APP_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Google OAuth credentials (optional)
# -----------------------------------------------------------------------------
GOOGLE_AUTHORIZED_REDIRECT_URI=https://notechondria.example.com/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Cloudflare R2 Storage (required – Northflank service filesystems are
# ephemeral across redeploys, so user-uploaded media must live on R2)
# -----------------------------------------------------------------------------
# Setup: https://developers.cloudflare.com/r2/
#   1. Create an R2 bucket in the Cloudflare dashboard.
#   2. Under R2 > Manage R2 API Tokens, create a token with read/write for
#      the bucket.
#   3. (Optional) Connect a custom domain or enable the r2.dev subdomain for
#      public access. Set CLOUDFLARE_R2_CUSTOM_DOMAIN to that hostname.
CLOUDFLARE_R2_BUCKET_NAME=notechondria
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLATE_Jurisdiction_specific_endpoints=https://<account-id>.r2.cloudflarestorage.com
# Optional: public hostname for the bucket (e.g. cdn.example.com).
CLOUDFLARE_R2_CUSTOM_DOMAIN=cdn.example.com
