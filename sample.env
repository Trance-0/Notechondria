# Django
DJANGO_SECRET_KEY=replace-with-secure-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS_COMPOSE=localhost 127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:9080,http://localhost:9060
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FILE_NAME=notechondria
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Host-exposed ports
APP_HOST_PORT=9080
BACKEND_HOST_PORT=9090
FRONTEND_HOST_PORT=9060
DB_HOST_PORT=9032

# PostgreSQL
POSTGRE_USERNAME=postgres
POSTGRE_PASSWORD=postgres
POSTGRE_HOST=db
POSTGRE_PORT=5432
POSTGRE_DB=postgres

# Static/media (production)
PRODUCTION_STATIC_ROOT=/home/staticfiles/
PRODUCTION_MEDIA_ROOT=/home/mediafiles/

# OpenAI integration (optional)
OPENAI_API_KEY=

# SMTP email verification
# If SMTP is empty or invalid, registration still succeeds and the verification code is written to server logs.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_FROM_EMAIL=no-reply@example.com
EMAIL_VERIFICATION_TTL_HOURS=24
# Frontend page where the user types or confirms the verification code from SMTP email.
FRONTEND_VERIFY_URL=http://localhost:9060/#/verify
# Flutter web build-time API target for the standalone frontend container.
# The nginx runtime proxies /api, /static, /media, and /admin to the backend origin.
FRONTEND_API_BASE_URL=/api/v1
FRONTEND_BACKEND_ORIGIN=http://nginx
NOTECHONDRIA_SHARED_NETWORK=notechondria-shared

# GitHub App integration (optional)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=

APP_IMAGE=trancezero/notechondria:build-local
NGINX_IMAGE=trancezero/nginx:build-local
FRONTEND_IMAGE=trancezero/notechondria-frontend:build-local
DB_AUTO_REINIT_IF_MISMATCH=False
