# =============================================================================
# Notechondria – Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your values.
#   cp sample.env .env
#
# All variables with placeholder values (YOUR_*, changeme, etc.) MUST be
# replaced before running the project.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=changeme-generate-a-random-64-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS_COMPOSE=localhost 127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:9080,http://localhost:9060
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FILE_NAME=notechondria
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme-strong-password
# Custom domain pointing to the backend (auto-detected on Render via
# RENDER_EXTERNAL_HOSTNAME).
BACKEND_CUSTOM_DOMAIN=
# Root path for collected static files inside the container.
DJANGO_PRODUCTION_STATIC_ROOT=/home/staticfiles/
# Root path for user-uploaded media files inside the container.
DJANGO_PRODUCTION_MEDIA_ROOT=/home/mediafiles/

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRE_USERNAME=postgres
POSTGRE_PASSWORD=changeme-db-password
POSTGRE_HOST=db
POSTGRE_PORT=5432
POSTGRE_DB=postgres

# -----------------------------------------------------------------------------
# Docker – Host-exposed ports
# -----------------------------------------------------------------------------
APP_HOST_PORT=9080
BACKEND_HOST_PORT=9090
FRONTEND_HOST_PORT=9060
DB_HOST_PORT=9032
ROOT_HTTP_PORT=8080

# -----------------------------------------------------------------------------
# SMTP Email
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_EMAIL@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_EMAIL_VERIFICATION_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Frontend origin for CORS (e.g. https://username.github.io).
FRONTEND_ORIGIN=
# Page where the user types or confirms the verification code.
FRONTEND_VERIFY_URL=http://localhost:9060/#/verify
# API base URL baked into the frontend at build time (--dart-define).
FRONTEND_API_BASE_URL=http://localhost:9060/api/v1
# Internal Docker network origin the frontend uses to proxy API requests.
FRONTEND_BACKEND_ORIGIN=http://nginx
# Base href for each frontend sub-app (fullstack compose overrides these).
APP_BASE_HREF=/

# -----------------------------------------------------------------------------
# OpenAI Integration (optional)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# GitHub App Integration (optional)
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_AUTHORIZED_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Google OAuth (optional – leave empty to disable Google sign-in)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_AUTHORIZED_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Per-app OAuth allow-lists (since 0.1.90)
# -----------------------------------------------------------------------------
# Comma-separated lists of redirect URIs registered in the OAuth provider
# console. The backend matches the request `Origin` / `Referer` against each
# entry and returns the matching URI from /api/v1/auth/oauth-config/, so
# editor / planner / portal each land back on their own host instead of
# always landing on the editor. The single-value vars above remain as a
# fallback when these lists are empty.
GOOGLE_AUTHORIZED_REDIRECT_URIS=
GITHUB_AUTHORIZED_REDIRECT_URIS=

# -----------------------------------------------------------------------------
# Casdoor SSO (since 0.1.96; primary auth surface in the UI since 0.1.99)
# -----------------------------------------------------------------------------
# When CASDOOR_ENDPOINT (and the four required fields below) are populated,
# the frontend leads with a "Continue with Casdoor SSO" button and the
# backend's CasdoorJWTAuthentication starts validating Bearer JWTs.
# Empty values keep the backend in shadow mode — legacy Token / API-key
# auth remain the only working paths.
#
# Step-by-step setup (admin UI walkthrough):
# docs/integrations/casdoor-setup.md
CASDOOR_ENDPOINT=https://auth.trance-0.com
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_ORG_NAME=notechondria
CASDOOR_APP_NAME=notechondria
# Public-key PEM from the Casdoor application's Cert. Single line, with
# literal `\n` in place of actual newlines. _normalize_pem in
# backend/creators/casdoor_auth.py converts it back at signing time.
CASDOOR_CERTIFICATE=
# Optional: how long to cache JWT-verification results (seconds).
CASDOOR_TOKEN_CACHE_TTL=300

# -----------------------------------------------------------------------------
# Backend version + build provenance (since 0.1.95)
# -----------------------------------------------------------------------------
# /api/v1/handshake/ returns the deployed version so the docs site, the
# frontend "About" surface, and CI smoke tests can verify which build is
# serving. BACKEND_VERSION is the escape hatch for runtimes where the
# Dockerfile's `COPY VERSION /home/VERSION` isn't reached (wheel / Procfile
# deploys); leave empty when the file ships into the image.
BACKEND_VERSION=
BACKEND_BUILD_COMMIT=
BACKEND_BUILD_TIME=
# Free-form label surfaced in the handshake `build.deploy_target` field —
# pick one of: jenkins / render / northflank / docker / dev.
BACKEND_DEPLOY_TARGET=

# -----------------------------------------------------------------------------
# GitHub data-sync App (since 0.1.90; push pipeline live in 0.1.93)
# -----------------------------------------------------------------------------
# Distinct from the GitHub OAuth App above — this one drives the
# experimental per-user data-sync feature. When unset, the backend's
# /api/v1/integrations/github/* endpoints all return shadow-mode 503 /
# `{configured: false}` and the frontend hides the "Connect to GitHub"
# card. See docs/integrations/github-sync.md.
GITHUB_DATA_SYNC_APP_NAME=notechondria-data-sync
GITHUB_DATA_SYNC_APP_CLIENT_ID=
GITHUB_DATA_SYNC_APP_CLIENT_SECRET=
GITHUB_DATA_SYNC_APP_PRIVATE_KEY=
GITHUB_DATA_SYNC_APP_INSTALL_URL=

# -----------------------------------------------------------------------------
# Cloudflare R2 Storage (optional – leave empty to use local volumes + nginx)
# -----------------------------------------------------------------------------
# When CLOUDFLARE_R2_BUCKET_NAME is set, Django uses R2 for both static and
# media files instead of local volumes. All credential fields below become
# required when the bucket name is set.
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional: public hostname for the bucket (e.g. cdn.example.com).
# If unset, URLs point to the S3 endpoint directly.
CLOUDFLARE_R2_CUSTOM_DOMAIN=

# -----------------------------------------------------------------------------
# Docker – Container images
# -----------------------------------------------------------------------------
APP_IMAGE=trancezero/notechondria:v0.1.15.local
NGINX_IMAGE=trancezero/nginx:v0.1.15.local
FRONTEND_IMAGE=trancezero/notechondria-frontend:v0.1.15.local

# -----------------------------------------------------------------------------
# Docker – Infrastructure
# -----------------------------------------------------------------------------
NOTECHONDRIA_SHARED_NETWORK=notechondria-shared
DB_AUTO_REINIT_IF_MISMATCH=False
