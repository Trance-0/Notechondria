# =============================================================================
# Notechondria — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your values.
#   cp sample.env .env
#
# All variables with placeholder values (YOUR_*, changeme, etc.) MUST be
# replaced before running the project.
# =============================================================================

# ---- Django ----
DJANGO_SECRET_KEY=changeme-generate-a-random-64-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Custom domain pointing to the backend (auto-detected on Render via RENDER_EXTERNAL_HOSTNAME)
CUSTOM_DOMAIN=
# Frontend origin for CORS (e.g. https://username.github.io)
FRONTEND_ORIGIN=
DJANGO_ALLOWED_HOSTS_COMPOSE=localhost 127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:9080,http://localhost:9060
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FILE_NAME=notechondria

# ---- Django Superuser (created on first migrate) ----
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme-strong-password

# ---- Host-exposed ports ----
APP_HOST_PORT=9080
BACKEND_HOST_PORT=9090
FRONTEND_HOST_PORT=9060
DB_HOST_PORT=9032

# ---- PostgreSQL ----
POSTGRE_USERNAME=postgres
POSTGRE_PASSWORD=changeme-db-password
POSTGRE_HOST=db
POSTGRE_PORT=5432
POSTGRE_DB=postgres

# ---- Static / Media (production) ----
PRODUCTION_STATIC_ROOT=/home/staticfiles/
PRODUCTION_MEDIA_ROOT=/home/mediafiles/

# ---- OpenAI integration (optional) ----
OPENAI_API_KEY=

# ---- SMTP email verification ----
# Required for email verification and password reset. If left blank the
# verification code is logged to the Django console instead of emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_EMAIL@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_FROM_EMAIL=no-reply@example.com
EMAIL_VERIFICATION_TTL_HOURS=24

# Frontend page where the user types or confirms the verification code.
FRONTEND_VERIFY_URL=http://localhost:9060/#/verify
FRONTEND_API_BASE_URL=http://localhost:9060/api/v1
FRONTEND_BACKEND_ORIGIN=http://nginx
NOTECHONDRIA_SHARED_NETWORK=notechondria-shared

# ---- GitHub App integration (optional) ----
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=

# ---- Docker image tags ----
APP_IMAGE=trancezero/notechondria:build-local
NGINX_IMAGE=trancezero/nginx:build-local
FRONTEND_IMAGE=trancezero/notechondria-frontend:build-local
DB_AUTO_REINIT_IF_MISMATCH=False
