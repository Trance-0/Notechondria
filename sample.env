# =============================================================================
# Notechondria – Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your values.
#   cp sample.env .env
#
# All variables with placeholder values (YOUR_*, changeme, etc.) MUST be
# replaced before running the project.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=changeme-generate-a-random-64-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS_COMPOSE=localhost 127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:9080,http://localhost:9060
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FILE_NAME=notechondria
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme-strong-password
# Custom domain pointing to the backend (auto-detected on Render via
# RENDER_EXTERNAL_HOSTNAME).
BACKEND_CUSTOM_DOMAIN=
# Root path for collected static files inside the container.
DJANGO_PRODUCTION_STATIC_ROOT=/home/staticfiles/
# Root path for user-uploaded media files inside the container.
DJANGO_PRODUCTION_MEDIA_ROOT=/home/mediafiles/

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRE_USERNAME=postgres
POSTGRE_PASSWORD=changeme-db-password
POSTGRE_HOST=db
POSTGRE_PORT=5432
POSTGRE_DB=postgres

# -----------------------------------------------------------------------------
# Docker – Host-exposed ports
# -----------------------------------------------------------------------------
APP_HOST_PORT=9080
BACKEND_HOST_PORT=9090
FRONTEND_HOST_PORT=9060
DB_HOST_PORT=9032
ROOT_HTTP_PORT=8080

# -----------------------------------------------------------------------------
# SMTP Email
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_EMAIL@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_EMAIL_VERIFICATION_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Frontend origin for CORS (e.g. https://username.github.io).
FRONTEND_ORIGIN=
# Page where the user types or confirms the verification code.
FRONTEND_VERIFY_URL=http://localhost:9060/#/verify
# API base URL baked into the frontend at build time (--dart-define).
FRONTEND_API_BASE_URL=http://localhost:9060/api/v1
# Internal Docker network origin the frontend uses to proxy API requests.
FRONTEND_BACKEND_ORIGIN=http://nginx
# Base href for each frontend sub-app (fullstack compose overrides these).
APP_BASE_HREF=/

# -----------------------------------------------------------------------------
# OpenAI Integration (optional)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# GitHub App Integration (optional)
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_AUTHORIZED_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Google OAuth (optional – leave empty to disable Google sign-in)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_AUTHORIZED_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Docker – Container images
# -----------------------------------------------------------------------------
APP_IMAGE=trancezero/notechondria:v0.1.12.local
NGINX_IMAGE=trancezero/nginx:v0.1.12.local
FRONTEND_IMAGE=trancezero/notechondria-frontend:v0.1.12.local

# -----------------------------------------------------------------------------
# Docker – Infrastructure
# -----------------------------------------------------------------------------
NOTECHONDRIA_SHARED_NETWORK=notechondria-shared
DB_AUTO_REINIT_IF_MISMATCH=False
